<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_audio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Audio Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Logo" />

        <TextView
            android:id="@+id/audio_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="مشغل الصوتيات والموسيقى"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🎵 صوتيات"
            android:textColor="#6ee7b7"
            android:textSize="10sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Track Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_card_item"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audio_track_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مجلد التحفيز والموسيقى"
            android:textColor="#e2ebe3"
            android:textSize="12sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_audio_prev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="⏮️ السابق"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/btn_audio_play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="▶️ تشغيل"
            android:textColor="#6ee7b7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btn_audio_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_btn_bg"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="التالي ⏭️"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>
</LinearLayout>
