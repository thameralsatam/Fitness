<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bg-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f291e"/>
      <stop offset="50%" stop-color="#1b4b38"/>
      <stop offset="100%" stop-color="#0a1d15"/>
    </linearGradient>
    <linearGradient id="metal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399"/>
      <stop offset="50%" stop-color="#10b981"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#10b981" flood-opacity="0.45"/>
    </filter>
  </defs>

  <!-- Squircle Rounded App Icon Base -->
  <rect width="512" height="512" rx="128" fill="url(#bg-grad)"/>
  
  <!-- Subtle Internal Border -->
  <rect x="8" y="8" width="496" height="496" rx="120" fill="none" stroke="#34d399" stroke-width="4" stroke-opacity="0.25"/>

  <!-- Iconic Dumbbell Graphic -->
  <g transform="translate(256, 256) rotate(-45) translate(-256, -256)" filter="url(#glow)">
    <!-- Central Bar -->
    <rect x="140" y="240" width="232" height="32" rx="16" fill="#e2ebe3"/>
    
    <!-- Left Inner Weight Plate -->
    <rect x="110" y="160" width="36" height="192" rx="18" fill="url(#metal-grad)"/>
    <!-- Left Outer Weight Plate -->
    <rect x="64" y="186" width="36" height="140" rx="18" fill="#047857"/>

    <!-- Right Inner Weight Plate -->
    <rect x="366" y="160" width="36" height="192" rx="18" fill="url(#metal-grad)"/>
    <!-- Right Outer Weight Plate -->
    <rect x="412" y="186" width="36" height="140" rx="18" fill="#047857"/>

    <!-- Bar Knurling Grips -->
    <line x1="220" y1="244" x2="220" y2="268" stroke="#75877d" stroke-width="4" stroke-linecap="round"/>
    <line x1="240" y1="244" x2="240" y2="268" stroke="#75877d" stroke-width="4" stroke-linecap="round"/>
    <line x1="260" y1="244" x2="260" y2="268" stroke="#75877d" stroke-width="4" stroke-linecap="round"/>
    <line x1="280" y1="244" x2="280" y2="268" stroke="#75877d" stroke-width="4" stroke-linecap="round"/>
    <line x1="292" y1="244" x2="292" y2="268" stroke="#75877d" stroke-width="4" stroke-linecap="round"/>
  </g>

  <!-- Accent Energy Sparks -->
  <circle cx="120" cy="120" r="10" fill="#34d399" opacity="0.6"/>
  <circle cx="392" cy="392" r="8" fill="#34d399" opacity="0.6"/>
</svg>
